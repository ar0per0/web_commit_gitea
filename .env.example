DATA_PATH=./data
WEB_PASSWORD=elige-una-contraseña-segura
HOST=127.0.0.1
TZ=Europe/Madrid
GITEA_USER=tu_usuario
GITEA_EMAIL=tu_email@example.com
GITEA_TOKEN=
GITEA_URL=https://gitea.example.com/
# Exigir que exista en Gitea para mostrar commit/push, ramas y etiquetas.
GITEA_REQUIRED=true
# Mostrar el apartado plegable y permitir consultar todos los repositorios accesibles al token.
SHOW_GITEA_PROJECTS=true

# Docker Compose: DATA_PATH es la carpeta del host; dentro se monta en /data.
# Usuario propietario de los proyectos y grupo del socket Docker (ver README).
APP_UID=1000
APP_GID=1000
DOCKER_GID=0
DOCKER_SOCKET=/var/run/docker.sock
# Para permitir acceso desde la red, cambia WEB_BIND_IP a 0.0.0.0.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8804
